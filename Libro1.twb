      <column aggregation='Avg' caption='Latitude1' datatype='real' name='[Calculation_217580172852281344]' role='dimension' semantic-role='[Geographical].[Latitude]' type='quantitative'>
        <calculation class='tableau' formula='IF [latitude]/100000 &gt; 40 AND [latitude]/100000 &lt; 43 THEN [latitude]/100000 END' />
